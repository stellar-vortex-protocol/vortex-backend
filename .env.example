# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Leave as-is for local Docker Compose (see docker-compose.yml).
DATABASE_URL=postgresql://vortex:vortex@localhost:5432/vortex?schema=public

# ─── Server ──────────────────────────────────────────────────────────────────
# Port the relay API + WebSocket feed listen on
PORT=4000
# Runtime mode. Production requires SOROBAN_SIGNING_KEY and an explicit
# ONCHAIN_DRY_RUN (see below); development and test default to the safest
# values. Valid: development | production | test
NODE_ENV=development

# ─── Stellar ─────────────────────────────────────────────────────────────────
# Network to operate against: testnet | futurenet | mainnet
STELLAR_NETWORK=testnet
ETHEREUM_RPC_URL=
ETHEREUM_ESCROW_ADDRESS=
BASE_RPC_URL=
BASE_ESCROW_ADDRESS=
POLYGON_RPC_URL=
POLYGON_ESCROW_ADDRESS=
ARBITRUM_RPC_URL=
ARBITRUM_ESCROW_ADDRESS=
OPTIMISM_RPC_URL=
OPTIMISM_ESCROW_ADDRESS=
AVALANCHE_RPC_URL=
AVALANCHE_ESCROW_ADDRESS=
EVM_RPC_ALLOWLIST=
# Soroban RPC endpoint (single-URL fallback — used when SOROBAN_RPC_URLS is unset)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Multi-endpoint RPC pool (#393): comma-separated URLs with optional weights.
# Format: "https://url1,https://url2@2"  (@2 = weight 2 = twice as likely to be selected)
# When set, SOROBAN_RPC_URLS takes precedence over SOROBAN_RPC_URL.
SOROBAN_RPC_URLS=
# Archival RPC URL for deep-history event backfill (#391).
# Leave blank to fall back to SOROBAN_RPC_URL for backfills within the retention window.
ARCHIVAL_RPC_URL=
# Horizon API endpoint (for account/balance queries)
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SIGNER_SECRET_KEY=

# Deployed contract IDs (leave blank until deployed)
SETTLEMENT_CONTRACT_ID=
SOLVER_REGISTRY_CONTRACT_ID=

# ─── Treasury ────────────────────────────────────────────────────────────────
# Stellar public key of the treasury account (fee accumulator)
TREASURY_ADDRESS=

# Secret key for the backend's own Soroban signer, used to submit on-chain
# writes (settlement, slashing). A Stellar secret seed: starts with "S",
# 56 base32 characters. Leave blank in development/test — no write path runs
# without it. REQUIRED in production (NODE_ENV=production), and validated
# against that format so it can never silently default to a placeholder.
#
# Local dev: generate a throwaway TESTNET-only keypair, do not reuse it
# anywhere real, and never commit a filled-in value:
#   npx @stellar/stellar-cli keys generate local-dev --network testnet
#   npx @stellar/stellar-cli keys show local-dev
# or, ad hoc, via the SDK:
#   node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
# Fund it on testnet with Friendbot before use:
#   curl "https://friendbot.stellar.org/?addr=<PUBLIC_KEY_FROM_ABOVE>"
SOROBAN_SIGNING_KEY=

# ─── Solver bot (scripts/solver-bot.ts) ─────────────────────────────────────
# Secret key for the reference solver bot — used to sign WS auth messages and
# REST request bodies (accept / fill). A Stellar secret seed (starts with "S").
# If unset, the bot runs in anonymous read-only mode (issue #121).
SOLVER_SECRET=
SOLVER_ADDRESS=
SOLVER_CHAINS=stellar,ethereum,base,polygon,arbitrum,optimism,avalanche

# ─── Persistence adapter selection ──────────────────────────────────────────
# Which repository adapter backs intents and solvers.
#   memory (default) — in-process Maps, no database required
#   prisma           — PostgreSQL via Prisma (staging / production)
INTENTS_PERSISTENCE=memory
ALLOW_LEGACY_STELLAR_SIGNATURES=false
SOLVERS_PERSISTENCE=memory

# ─── On-chain writes ────────────────────────────────────────────────────────
# Register intents with the settlement contract on create().
ONCHAIN_INTENTS_ENABLED=false

# Simulate-only switch for every on-chain write path (invokeContract,
# slashSolver). When true, transactions are built and simulated but never
# broadcast. Defaults to true outside production; REQUIRED in production so a
# deployer must consciously choose simulate-only vs live writes. See
# docs/runbooks/onchain-cutover.md.
ONCHAIN_DRY_RUN=true

# Percentile of recent Soroban inclusion-fee stats used when estimating fees.
# One of: min mode p10 p20 p30 p40 p50 p60 p70 p80 p90 p95 p99 max
SOROBAN_FEE_PERCENTILE=p50

# ─── Intent retention ───────────────────────────────────────────────────────
# Days terminal (filled/cancelled/expired/slashed) intents are kept in the
# in-memory adapter, and how often the eviction sweep runs (ms). Set
# INTENT_RETENTION_DAYS=0 to disable retention-based eviction.
INTENT_RETENTION_DAYS=30
INTENT_RETENTION_SWEEP_MS=60000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
# Development default: "*"  (any origin allowed — convenient for local work)
# Production REQUIRED: must be an explicit origin, never "*"
#   e.g. CORS_ORIGIN=https://app.vortex.trade
# The app will refuse to start in production if this is "*" or unset.
CORS_ORIGIN=*

# ─── WebSocket ───────────────────────────────────────────────────────────────
# Maximum number of concurrent WebSocket connections accepted by the gateway.
# Connections beyond this limit are rejected with close code 1013 (try again later).
# Set to 0 to disable the cap (not recommended in production).
WS_MAX_CONNECTIONS=1000

# Optional backplane for multi-instance fan-out. Default is "memory".
# Set to "redis" to publish WS events through Redis pub/sub and maintain a
# globally-shared seq counter for replay semantics.
WS_BACKPLANE=memory
REDIS_URL=redis://localhost:6379

# ─── Reconciler (#392) ───────────────────────────────────────────────────────
# Seconds a non-terminal intent must be stale (no ingestion update) before the
# reconciler reads its state from the settlement contract. Default: 300 (5 min).
RECONCILE_STALE_SECONDS=300

# ─── Soroban Fee & Channel Pool ───────────────────────────────────────────────
# Fee percentile used when estimating Soroban inclusion fees.
SOROBAN_FEE_PERCENTILE=p50

# Maximum fee in stroops for fee-bump escalation (#388).
# Default 1_000_000 stroops (0.1 XLM). Raise for busy mainnet periods.
SOROBAN_MAX_FEE_STROOPS=1000000

# Number of channel accounts in the pool (#387). Default 8.
CHANNEL_POOL_SIZE=8

# Comma-separated Stellar secret keys for channel accounts (#387).
# Generate with: tsx scripts/create-channels.ts
# NEVER commit real keys. Leave blank to disable channel pool.
CHANNEL_SECRET_KEYS=

# ─── Pluggable signer backend (issue #400) ───────────────────────────────────
# SIGNER_BACKEND selects the signing implementation:
#   "local"  (default) — key from SOROBAN_SIGNING_KEY / SOROBAN_SIGNING_KEY_FILE.
#                        Refused in NODE_ENV=production unless ALLOW_LOCAL_SIGNER_IN_PROD=true.
#   "vault"            — HashiCorp Vault Transit (ed25519); key never in process RAM.
#                        Requires VAULT_ADDR + VAULT_TOKEN.
SIGNER_BACKEND=local

# Required when SIGNER_BACKEND=vault:
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY_NAME=vortex-signer

# Emergency escape hatch — allow LocalKeypairSigner in production.
# Never set this on a real production deployment; migrate to SIGNER_BACKEND=vault.
ALLOW_LOCAL_SIGNER_IN_PROD=false
# ─── Resource-exhaustion limits (issue #476) ─────────────────────────────────
# Maximum JSON nesting depth accepted before the body is rejected with 400.
# Rejects stack-exhaustion attacks that craft deeply-nested payloads.
# Default: 10 (all real DTOs are flat or two levels deep; 10 gives ×3 margin).
JSON_MAX_DEPTH=10

# Maximum chain-filter values allowed in a single WS subscribe message.
# Default: 20 (2× the number of supported chains — generous for multi-chain bots).
WS_MAX_FILTER_CHAINS=20

# Maximum active subscriptions a single WS connection may hold.
# Default: 10
WS_MAX_SUBSCRIPTIONS=10

# Postgres statement_timeout (milliseconds) for standard route queries.
# Default: 5000 (5 s)
DB_QUERY_TIMEOUT_MS=5000

# Postgres statement_timeout (milliseconds) for batch-lookup queries.
# Default: 10000 (10 s)
DB_BATCH_QUERY_TIMEOUT_MS=10000

# Postgres statement_timeout (milliseconds) for stats/aggregate queries.
# Default: 15000 (15 s)
DB_STATS_QUERY_TIMEOUT_MS=15000

# Emergency kill-switch (issue #477)
# ---------------------------------
# Shared secret for the operator control plane at /api/v1/ops/killswitch.
# Leave empty to DISABLE those routes entirely (fail closed, never open).
# Required in production.
KILLSWITCH_OPERATOR_TOKEN=

# Redis URL for cross-replica pause propagation. Leave empty to rely on the
# database poll only, which still meets the 5 s budget. Defaults to REDIS_URL
# when WS_BACKPLANE=redis.
KILLSWITCH_REDIS_URL=

# Database change-probe interval (ms) that backstops Redis pub/sub.
# Worst-case propagation delay is roughly this value. 100-5000, default 2000.
KILLSWITCH_POLL_MS=2000

# Persistence backend for kill-switch state.
#   memory (default) - in-process, resets on restart. Dev/test only.
#   prisma           - Postgres, survives restarts. Required for a real
#                      multi-replica deployment.
KILLSWITCH_PERSISTENCE=memory
# ─── Observability ──────────────────────────────────────────────────────────
# Winston log level. One of: error warn info http verbose debug silly
LOG_LEVEL=debug
# Service name attached to every structured log line.
LOG_SERVICE_NAME=vortex-backend
# Sentry DSN for error reporting. Leave blank to disable Sentry entirely.
SENTRY_DSN=

# Optional log shipping to a central collector. Off by default so local dev and
# CI stay stdout-only. When enabled, LOG_SHIPPING_HOST is required.
LOG_SHIPPING_ENABLED=false
LOG_SHIPPING_HOST=
LOG_SHIPPING_PORT=514
LOG_SHIPPING_PATH=/
LOG_SHIPPING_SSL=false

# ─── Shadow-mode divergence monitor (issue #401) ────────────────────────────
# Runs on-chain *simulations* of every intent state transition in parallel with
# the authoritative off-chain path and reports where the two disagree, so the
# cutover runbook can quote a quantitative go/no-go threshold instead of a
# guess. Nothing is ever submitted: the only RPC call used is
# simulateTransaction, which never broadcasts, never signs and never charges a
# fee.
#
# Off by default — a sampled simulation is a real RPC call, so this is an
# explicit per-environment opt-in rather than something you discover you are
# paying for.
#
# Enable:
#   SHADOW_MODE_ENABLED=true
#
# Inspect the result:
#   curl http://localhost:4000/api/v1/admin/shadow-report?days=7
#   http://localhost:4000/metrics | grep vortex_shadow
#
# See docs/runbooks/onchain-cutover.md ("Shadow-mode go/no-go") for the
# threshold this has to clear before flipping ONCHAIN_DRY_RUN=false.
SHADOW_MODE_ENABLED=false

# Fraction of transitions to simulate, as a probability in [0, 1].
# 1 = every transition (recommended for a go/no-go soak: sampling makes the
# divergence rate a statistical estimate rather than a census).
SHADOW_SAMPLE_RATE=1

# Hard cap on queued observations. Beyond this, observations are dropped and
# counted (vortex_shadow_dropped_total) rather than queued — a slow or
# unreachable Soroban RPC degrades the monitor, never the request path.
SHADOW_QUEUE_MAX=256

# How many queued observations the background drain simulates concurrently.
SHADOW_CONCURRENCY=4

# Public key used as the transaction source for shadow simulations (strkey
# G...). Never signed, never submitted, never charged — it only has to be a
# valid address for the envelope. Optional: when empty the monitor reports
# "contract_unconfigured" instead of silently recording zero divergence.
#   npx @stellar/stellar-cli keys generate shadow-sim --network testnet
#   npx @stellar/stellar-cli keys show shadow-sim --public-key
SHADOW_SOURCE_ACCOUNT=
# ─── Governance / Protocol Parameters ────────────────────────────────────────
# On-chain governance parameters contract ID (Soroban contract address).
# When set, ProtocolParamsService reads fee bps, fill windows, deadlines,
# exposure ratio, and slash amount from the contract and exposes them via
# GET /api/v1/params.  Leave blank to use code/env defaults.
PARAMS_CONTRACT_ID=

# How often (ms) to poll the parameters contract.  Default: 30 000 (30 s).
# Lower values increase RPC load; raise in production if rate-limited.
PARAMS_POLL_INTERVAL_MS=30000
# ─── Leader election ─────────────────────────────────────────────────────────
# Set to true to enable Postgres advisory-lock based leader election so
# singleton workers (sweeper, event-ingestion) run on exactly one replica.
# Requires DATABASE_URL to point at a live Postgres instance.
# IMPORTANT: do not use PgBouncer in transaction-pooling mode for this;
# advisory locks are session-scoped and will be dropped when the connection
# is returned to the pool. Use a direct connection or session-mode pooling.
LEADER_ELECTION_ENABLED=false
# Heartbeat interval (ms). Default 5000 gives ≤ 15 s failover.
LEADER_ELECTION_HEARTBEAT_MS=5000

# ─── Background jobs (issue #494) ────────────────────────────────────────────
# api | worker | all — queue workers only run in "worker" or "all".
PROCESS_ROLE=all
# memory (single-process, dev/test) | bullmq (Redis-backed, uses REDIS_URL)
JOBS_DRIVER=memory
# Grace period for in-flight jobs on SIGTERM before they are returned to the queue.
JOBS_SHUTDOWN_TIMEOUT_MS=25000

# ─── Runtime feature flags (issue #495) ──────────────────────────────────────
# Change propagation across instances: memory (single instance) | redis
FLAGS_PUBSUB=memory
# Safety-net cache reload interval (ms)
FLAGS_REFRESH_MS=30000
# Break-glass pins that win over DB state, e.g. onchain-dry-run=true
FLAG_OVERRIDES=

# ─── Admin RBAC ──────────────────────────────────────────────────────────────
# Comma-separated id:role:secret (role = admin | superadmin, secret >= 16 chars).
# Sent as the x-admin-key header (the secret part). Empty disables admin APIs.
ADMIN_API_KEYS=

# ─── Guardian emergency ingestion (issue #507) ───────────────────────────────
# Guardian / security-council contract ID. Leave blank to disable ingestion.
GUARDIAN_CONTRACT_ID=

# ─── Synthetic canary (issue #496) ───────────────────────────────────────────
# Canary user + solver addresses; excluded from public stats and leaderboards.
CANARY_ADDRESSES=

# Public anonymised datasets (docs/rfcs/0001)
# Master switch for the public dataset publication job.
DATASETS_ENABLED=false
# Hash user addresses with the rotating salt before export.
DATASETS_ANONYMIZE=true
# Base anonymisation salt. Required (>= 32 chars) when datasets are enabled
# and anonymisation is on; generate with `openssl rand -hex 32`.
DATASETS_SALT=
# How often the anonymisation salt rotates, in hours.
DATASETS_SALT_ROTATION_HOURS=24
# How many previous salt windows are retained for continuity.
DATASETS_SALT_RETENTION_WINDOWS=2
# Public bucket/prefix the published datasets live under.
DATASETS_PUBLIC_BUCKET=vortex-public-datasets
# Storage backend: local (writes to disk) | memory (tests only).
DATASETS_STORAGE=local
# Root directory for the local storage backend.
DATASETS_LOCAL_DIR=.datasets

# Secrets Manager (issue #465)
# Provider: env | aws-secrets-manager | vault-kv
SECRETS_PROVIDER=env
# Poll interval for secret rotation (ms)
SECRETS_REFRESH_INTERVAL_MS=60000
# Extra secrets: comma-separated "name:envVar:required"
SECRETS_EXTRA=

# AWS Secrets Manager
AWS_SECRETS_MANAGER_PREFIX=
AWS_SECRETS_MANAGER_POLL_INTERVAL_MS=60000

# Vault KV
VAULT_KV_MOUNT=secret
VAULT_KV_PREFIX=vortex/
VAULT_KV_POLL_INTERVAL_MS=60000

# Extra secret env vars referenced by the default SecretConfig
JWT_SIGNING_KEY=
WEBHOOK_SECRET=
CHANNEL_KEY=

# Egress/SSRF Protection
EGRESS_TIMEOUT_MS=10000
EGRESS_MAX_REDIRECTS=3
EGRESS_MAX_BODY_SIZE_BYTES=10485760
SOROBAN_RPC_ALLOWLIST=soroban-testnet.stellar.org,soroban-rpc.stellar.org
WEBHOOK_ALLOWLIST=hooks.example.com,hooks.trusted.com
ORACLE_ALLOWLIST=oracle.trusted.io
# ─── WS gateway hardening (issue #455) ───────────────────────────────────────
# Inbound frames larger than this close the socket (1009).
WS_MAX_PAYLOAD_BYTES=16384
# Concurrent WS connections per client IP (0 = unlimited).
WS_MAX_CONNECTIONS_PER_IP=20
# Trusted reverse-proxy hops for X-Forwarded-For (0 = socket address only).
WS_TRUST_PROXY_HOPS=0
# Inbound token bucket per connection; repeat violators are disconnected.
WS_RATE_LIMIT_PER_SEC=10
WS_RATE_LIMIT_BURST=20
WS_RATE_LIMIT_MAX_VIOLATIONS=5
# Outbound backpressure: messages held per slow consumer, socket buffer
# threshold (bytes), and what to do when the queue is full.
WS_OUTBOUND_QUEUE_MAX=1000
WS_OUTBOUND_BUFFER_BYTES=1048576
WS_SLOW_CONSUMER_POLICY=drop_oldest

# ─── WS graceful shutdown (Activity 2) ───────────────────────────────────────
# Time (ms) to drain connections on SIGTERM before forceful shutdown.
# Should align with Kubernetes terminationGracePeriodSeconds (default 30s).
WS_DRAIN_TIMEOUT_MS=25000

# HS256 secret for solver JWTs from the SEP-10 auth flow (#442); >= 32 chars.
# Empty disables JWT auth on the WS gateway.
AUTH_JWT_SECRET=

# ─── API keys & distributed rate limiting (issue #441) ─────────────────────────
# How often (ms) the local rate-limiter fallback prunes expired window entries.
# Only relevant during a Redis outage; keeps the fallback map bounded.
RATE_LIMIT_LOCAL_PRUNE_MS=60000
# Redis URL for the shared rate-limit window. Leave empty to force the bounded
# local limiter (the limit is still enforced, just per process).
RATE_LIMIT_REDIS_URL=

# ─── Scoped solver credentials (issue #443) ───────────────────────────────────
# Cross-replica transport for credential revocation invalidation:
# memory (single instance) | redis (pub/sub, uses REDIS_URL).
CREDENTIAL_REVOCATION_PUBSUB=memory

# ─── SSE intent feed (issue #433) ─────────────────────────────────────────────
# Heartbeat comment interval (ms) for GET /api/v1/stream/intents.
SSE_HEARTBEAT_MS=15000
# Maximum buffered output bytes per SSE client before it is disconnected.
SSE_MAX_BUFFER_BYTES=1048576

# ─── Public anonymised datasets ──────────────────────────────────────────────
DATASETS_ENABLED=false
DATASETS_ANONYMIZE=true
DATASETS_SALT=
DATASETS_SALT_ROTATION_HOURS=24
DATASETS_SALT_RETENTION_WINDOWS=2
DATASETS_PUBLIC_BUCKET=
DATASETS_STORAGE_KIND=memory
DATASETS_LOCAL_DIR=

# ─── Health probes (issue #492) ──────────────────────────────────────────────
# Roles served by this process (api, ws, worker); readiness checks follow them.
SERVICE_ROLES=api,ws,worker
HEALTH_CHECK_INTERVAL_MS=5000
# Readiness hysteresis: failures before not-ready, successes before ready again.
HEALTH_READY_FAILURE_THRESHOLD=3
HEALTH_READY_SUCCESS_THRESHOLD=2
# Liveness fails when event-loop delay exceeds this.
HEALTH_EVENT_LOOP_MAX_LAG_MS=1000
# Soroban RPC endpoints for the quorum check (default: SOROBAN_RPC_URL).
SOROBAN_RPC_HEALTH_URLS=

# Maximum number of concurrent WebSocket connections accepted by the gateway.
# Connections beyond this limit are rejected with close code 1013 (try again later).
# Set to 0 to disable the cap (not recommended in production).
WS_MAX_CONNECTIONS=1000

# Optional backplane for multi-instance fan-out. Default is "memory".
# Set to "redis" to publish WS events through Redis pub/sub and maintain a
# globally-shared seq counter for replay semantics.
WS_BACKPLANE=memory
REDIS_URL=redis://localhost:6379

