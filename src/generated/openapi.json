        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptIntentDto"
              }
            }
          }
        },
        "responses": {
          "403": {
            "description": "Solver not registered or inactive"
          },
          "404": {
            "description": "Intent not found"
          },
          "409": {
            "description": "Intent is not in open state"
          },
          "410": {
            "description": "Intent has expired"
          }
        },
        "tags": [
          "intents"
        ]
      }
    },
    "/api/v1/intents/{id}/fill": {
      "post": {
        "operationId": "IntentsController_fill",
