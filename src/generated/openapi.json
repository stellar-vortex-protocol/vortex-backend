  "info": {
    "title": "Vortex Backend",
    "description": "Intent relay API + WebSocket feed for Vortex Protocol",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "intents",
      "description": ""
    },
    {
      "name": "solvers",
      "description": ""
    },
    {
      "name": "tokens",
      "description": ""
    },
    {
      "name": "stats",
      "description": ""
    },
    {
      "name": "chain",
      "description": ""
    }
  ],
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development"
    },
    {
      "url": "https://api.vortex.trade",
      "description": "Production"
    }
  ],
  "components": {
    "schemas": {
      "CreateIntentDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "description": "Stellar address of the user creating the intent"
          },
          "srcChain": {
            "type": "string",
            "enum": [
              "stellar",
              "ethereum",
              "base",
              "polygon",
              "arbitrum",
              "optimism",
              "avalanche"
            ],
            "description": "Source chain the funds are coming from"
          },
          "srcTokenAddress": {
            "type": "string",
            "description": "Source token contract/address on srcChain"
          },
          "srcTokenSymbol": {
            "type": "string",
            "description": "Source token symbol, e.g. USDC"
          },
          "srcTokenDecimals": {
            "type": "number",
            "minimum": 0,
            "maximum": 18,
            "description": "Source token decimals"
          },
          "srcAmount": {
            "type": "string",
            "description": "Source amount as a non-negative integer string (base units)"
          },
          "dstTokenContract": {
            "type": "string",
            "description": "Destination Stellar token contract"
          },
          "dstTokenSymbol": {
            "type": "string",
            "description": "Destination token symbol, e.g. USDC"
          },
          "dstTokenDecimals": {
            "type": "number",
            "minimum": 0,
            "maximum": 18,
            "description": "Destination token decimals"
          },
          "minDstAmount": {
            "type": "string",
            "description": "Minimum acceptable destination amount as an integer string"
          },
          "deadline": {
            "type": "number",
            "description": "Unix timestamp deadline; defaults to now + 1800s; must be between now+60s and now+24h"
          },
          "idempotencyKey": {
            "type": "string",
            "description": "Idempotency key for deduplicating duplicate requests"
          }
        },
        "required": [
          "user",
          "srcChain",
          "srcTokenAddress",
          "srcTokenSymbol",
          "srcTokenDecimals",
          "srcAmount",
          "dstTokenContract",
          "dstTokenSymbol",
          "dstTokenDecimals",
          "minDstAmount"
        ]
      },
      "AcceptIntentDto": {
        "type": "object",
        "properties": {
          "solver": {
            "type": "string",
            "description": "Solver address accepting the intent"
          },
          "signature": {
            "type": "string",
            "description": "Base64-encoded Ed25519 signature of the message \"accept:<intentId>:<solver>\" produced by the solver's private key"
          }
        },
        "required": [
          "solver",
          "signature"
        ]
      },
      "FillIntentDto": {
        "type": "object",
        "properties": {
          "solver": {
            "type": "string",
            "description": "Solver address filling the intent (must match the accepting solver)"
          },
          "fillAmount": {
            "type": "string",
            "description": "Amount filled, as a non-negative integer string"
          },
          "txHash": {
            "type": "string",
            "description": "Stellar fill transaction hash"
          },
          "signature": {
            "type": "string",
            "description": "Base64-encoded Ed25519 signature of the message \"fill:<intentId>:<solver>\" produced by the solver's private key"
          }
        },
        "required": [
          "solver",
          "fillAmount",
          "signature"
        ]
      },
      "CancelIntentDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "description": "Stellar address of the intent's original creator (must match)"
          },
          "signature": {
            "type": "string",
            "description": "Base64-encoded Ed25519 signature of the message \"cancel:<intentId>\" produced by the private key of `user`"
          }
        },
        "required": [
          "user",
          "signature"
        ]
      },
      "QuoteRequestDto": {
        "type": "object",
        "properties": {
          "srcChain": {
            "type": "string",
            "enum": [
              "stellar",
              "ethereum",
              "base",
              "polygon",
              "arbitrum",
              "optimism",
              "avalanche"
            ],
            "description": "Source chain the funds are coming from"
          },
          "srcTokenSymbol": {
            "type": "string",
            "description": "Source token symbol, e.g. USDC"
          },
          "srcAmount": {
            "type": "string",
            "description": "Source amount as a non-negative integer string"
          },
          "dstTokenSymbol": {
            "type": "string",
            "description": "Destination token symbol, e.g. USDC"
          },
          "intentId": {
            "type": "string",
            "description": "Intent ID to persist the quote to"
          }
        },
        "required": [
          "srcChain",
          "srcTokenSymbol",
          "srcAmount",
          "dstTokenSymbol"
        ]
      },
      "QuoteDto": {
        "type": "object",
        "properties": {
          "solver": {
            "type": "string",
            "description": "Solver address"
          },
          "solverName": {
            "type": "string",
            "description": "Solver name"
          },
          "dstAmount": {
            "type": "string",
            "description": "Destination amount as a string"
          },
          "fee": {
            "type": "string",
            "description": "Protocol fee as a string"
          },
          "fillTime": {
            "type": "number",
            "description": "Estimated fill time in seconds"
          },
          "expiresAt": {
            "type": "number",
            "description": "Unix timestamp when quote expires"
          }
        },
        "required": [
          "solver",
          "solverName",
          "dstAmount",
          "fee",
          "fillTime",
          "expiresAt"
        ]
      },
      "QuoteResponseDto": {
        "type": "object",
        "properties": {
          "quotes": {
            "description": "Array of quotes sorted by best dstAmount first",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuoteDto"
            }
          },
          "bestQuote": {
            "nullable": true,
            "description": "Best quote or null if no solvers available",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/QuoteDto"
              }
            ]
          },
          "srcChain": {
            "type": "string",
            "description": "Source chain"
          },
          "srcTokenSymbol": {
            "type": "string",
            "description": "Source token symbol"
          },
          "srcAmount": {
            "type": "string",
            "description": "Source amount as a string"
          },
          "dstTokenSymbol": {
            "type": "string",
            "description": "Destination token symbol"
          },
          "estimatedFillTime": {
            "type": "number",
            "description": "Estimated fill time in seconds for the best quote"
          }
        },
        "required": [
          "quotes",
          "bestQuote",
          "srcChain",
          "srcTokenSymbol",
          "srcAmount",
          "dstTokenSymbol",
          "estimatedFillTime"
        ]
      },
      "RegisterSolverDto": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "Solver's Stellar address"
          },
          "name": {
            "type": "string",
            "description": "Solver's display name"
          },
          "bondAmount": {
            "type": "string",
            "description": "Bond amount as a non-negative integer string (in USDC base units)"
          },
          "avgFillTime": {
            "type": "number",
            "description": "Average fill time in seconds"
          },
          "supportedChains": {
            "type": "array",
            "description": "Chains this solver supports",
            "items": {
              "type": "string",
              "enum": [
                "stellar",
                "ethereum",
                "base",
                "polygon",
                "arbitrum",
                "optimism",
                "avalanche"
              ]
            }
          },
          "supportedTokens": {
            "description": "Token symbols this solver supports",
            "type": "array",
            "items": {
              "type": "array"
            }
          }
        },
        "required": [
          "address",
          "name",
          "bondAmount",
          "avgFillTime",
          "supportedChains",
          "supportedTokens"
        ]
      }
    }
  }
}
