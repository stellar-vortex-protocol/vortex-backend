# .env.mainnet.example
#
# Environment template for PRODUCTION against Stellar MAINNET.
# Copy to .env (or inject via your secrets manager) and fill in every
# value marked with <CHANGE_ME>.  ALL values marked REQUIRED will cause
# the process to refuse to start if left blank.
#
#   cp .env.mainnet.example .env
#
# ⚠  WARNING — MAINNET CHECKLIST ⚠
#   □  SOROBAN_SIGNING_KEY is a real, funded mainnet keypair stored in a
#      proper secrets manager (AWS Secrets Manager, Vault, etc.).  Never
#      commit it to version control.
#   □  CORS_ORIGIN is an explicit origin — never "*" in production.
#   □  SETTLEMENT_CONTRACT_ID and SOLVER_REGISTRY_CONTRACT_ID are the
#      deployed mainnet contract addresses.
#   □  DATABASE_URL points to a production-grade managed database, not a
#      local Docker container.
#   □  NODE_ENV=production (enforces signing-key validation at startup).
#
# Closes #136

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED: production Postgres connection string.
# Use a secrets manager to inject this — never hardcode credentials here.
DATABASE_URL=<CHANGE_ME>  # e.g. postgresql://vortex:<SECRET>@db.prod.vortex.trade:5432/vortex?schema=public

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
# REQUIRED: must be "production" to enable signing-key validation and strict
# CORS enforcement at startup.
NODE_ENV=production

# ─── Stellar / Soroban ───────────────────────────────────────────────────────
# REQUIRED: mainnet only.
STELLAR_NETWORK=mainnet
SOROBAN_RPC_URL=https://mainnet.stellar.validationcloud.io/v1/<YOUR_API_KEY>
# Alternative public endpoints (pick one or run your own):
#   https://soroban.stellar.org     — Stellar Foundation (rate-limited)
#   https://rpc.ankr.com/stellar    — Ankr

# REQUIRED: deployed mainnet contract addresses.
# The process will warn (not exit) if these are blank in non-production
# environments, but will refuse to operate correctly without them.
SETTLEMENT_CONTRACT_ID=<CHANGE_ME>         # 56-char Stellar contract ID
SOLVER_REGISTRY_CONTRACT_ID=<CHANGE_ME>    # 56-char Stellar contract ID

# REQUIRED in production: backend Soroban signer secret seed.
# Must be a valid Stellar secret seed (starts with "S", 56 base32 chars).
# The process exits at startup if this is missing or malformed in production.
# Store in a secrets manager and inject at runtime — never commit.
SOROBAN_SIGNING_KEY=<CHANGE_ME>

# Fee percentile used when estimating Soroban inclusion fees.
# p90 provides better confirmation speed on mainnet under load.
SOROBAN_FEE_PERCENTILE=p90

# ─── CORS ────────────────────────────────────────────────────────────────────
# REQUIRED: explicit origin — "*" is rejected in production.
CORS_ORIGIN=https://app.vortex.trade    # <CHANGE_ME>

# ─── WebSocket ───────────────────────────────────────────────────────────────
# Tune based on expected solver + frontend connection count.
WS_MAX_CONNECTIONS=5000
# Replay log backend (memory | redis) and retention (issue #457).
# Production: use redis so the replay window survives restarts and replica
# switches (requires REDIS_URL below). Requests older than the window get
# `replay_too_old` — clients re-fetch a snapshot; infinite history is out of
# scope (use the REST API).
WS_REPLAY_STORE=redis
WS_REPLAY_MAX_EVENTS=5000
WS_REPLAY_MAX_AGE_MS=0

# ─── Pluggable signer backend (issue #400) ───────────────────────────────────
# REQUIRED in production: use SIGNER_BACKEND=vault so the signing key never
# resides in process memory.  Set ALLOW_LOCAL_SIGNER_IN_PROD=true only as an
# emergency escape hatch with explicit operator sign-off.
SIGNER_BACKEND=vault                   # <CHANGE_ME if using local for staging>
VAULT_ADDR=<CHANGE_ME>                 # e.g. https://vault.internal:8200
VAULT_TOKEN=<CHANGE_ME>                # inject via secrets manager at runtime
VAULT_TRANSIT_KEY_NAME=vortex-signer
ALLOW_LOCAL_SIGNER_IN_PROD=false
# ─── Resource-exhaustion limits (issue #476) ─────────────────────────────────
# Tune these conservatively in production.
JSON_MAX_DEPTH=10
WS_MAX_FILTER_CHAINS=20
WS_MAX_SUBSCRIPTIONS=10
DB_QUERY_TIMEOUT_MS=5000
DB_BATCH_QUERY_TIMEOUT_MS=10000
DB_STATS_QUERY_TIMEOUT_MS=15000

# --- Emergency kill-switch (issue #477) -------------------------------------
# Required in production. Without it the pause control plane is disabled and
# there is no way to stop writes at runtime.
# Generate with: openssl rand -hex 32
KILLSWITCH_OPERATOR_TOKEN=<CHANGE_ME>

# Leave empty to use the database poll alone. Set to the same Redis the WS
# backplane uses to get sub-second propagation.
KILLSWITCH_REDIS_URL=

# DB change-probe interval (ms) backing up Redis pub/sub. Keep this well under
# 5000 so worst-case propagation stays inside the 5 s requirement.
KILLSWITCH_POLL_MS=2000

# Must be prisma in production: a pause in memory is lost on every restart and
# is not visible to other replicas.
KILLSWITCH_PERSISTENCE=prisma

# ─── Observability ───────────────────────────────────────────────────────────
# Recommended in production: set to your Sentry project DSN.
SENTRY_DSN=<CHANGE_ME>

# info is the right level for production — "debug" is too noisy.
LOG_LEVEL=info

# ── Shadow-mode divergence monitor (issue #401) ─────────────────────────
# Off by default in every environment. It runs read-only `simulateTransaction`
# calls against SETTLEMENT_CONTRACT_ID in parallel with the off-chain intent
# path and never signs or submits anything.
#
# SHADOW_SOURCE_ACCOUNT only has to be a valid Stellar public key: it is used to
# populate the source-account field of the simulated envelope and is never
# signed, never charged a fee and never broadcast. It must still be set, or
# every transition reports "contract_unconfigured".
SHADOW_MODE_ENABLED=false
SHADOW_SAMPLE_RATE=1
SHADOW_QUEUE_MAX=256
SHADOW_CONCURRENCY=4
SHADOW_SOURCE_ACCOUNT=
# ─── Governance / Protocol Parameters ────────────────────────────────────────
# RECOMMENDED: set to the deployed mainnet governance parameters contract ID.
# Leave blank to fall back to code/env defaults (no on-chain governance reads).
PARAMS_CONTRACT_ID=<CHANGE_ME>

# Lower poll interval (e.g. 60 000) reduces RPC load in production.
PARAMS_POLL_INTERVAL_MS=60000
# ─── Leader election ─────────────────────────────────────────────────────────
# REQUIRED for multi-replica production deployments: set to true.
# Do NOT use PgBouncer in transaction-pooling mode — use direct connection.
LEADER_ELECTION_ENABLED=true
LEADER_ELECTION_HEARTBEAT_MS=5000

# ─── Background jobs (issue #494) ────────────────────────────────────────────
# api | worker | all — queue workers only run in "worker" or "all".
PROCESS_ROLE=api
# memory (single-process, dev/test) | bullmq (Redis-backed, uses REDIS_URL)
JOBS_DRIVER=bullmq
REDIS_URL=redis://redis:6379
# Grace period for in-flight jobs on SIGTERM before they are returned to the queue.
JOBS_SHUTDOWN_TIMEOUT_MS=25000

# ─── Runtime feature flags (issue #495) ──────────────────────────────────────
# Change propagation across instances: memory (single instance) | redis
FLAGS_PUBSUB=redis
# Safety-net cache reload interval (ms)
FLAGS_REFRESH_MS=30000
# Break-glass pins that win over DB state, e.g. onchain-dry-run=true
FLAG_OVERRIDES=

# ─── Admin RBAC ──────────────────────────────────────────────────────────────
# Comma-separated id:role:secret (role = admin | superadmin, secret >= 16 chars).
# Sent as the x-admin-key header (the secret part). Empty disables admin APIs.
ADMIN_API_KEYS=

# ─── Guardian emergency ingestion (issue #507) ───────────────────────────────
# Guardian / security-council contract ID. Leave blank to disable ingestion.
GUARDIAN_CONTRACT_ID=

# ─── Synthetic canary (issue #496) ───────────────────────────────────────────
# Canary user + solver addresses; excluded from public stats and leaderboards.
CANARY_ADDRESSES=

# Public anonymised datasets (docs/rfcs/0001)
# Master switch for the public dataset publication job.
DATASETS_ENABLED=false
# Hash user addresses with the rotating salt before export.
DATASETS_ANONYMIZE=true
# Base anonymisation salt. Required (>= 32 chars) when datasets are enabled
# and anonymisation is on; generate with `openssl rand -hex 32`.
DATASETS_SALT=
# How often the anonymisation salt rotates, in hours.
DATASETS_SALT_ROTATION_HOURS=24
# How many previous salt windows are retained for continuity.
DATASETS_SALT_RETENTION_WINDOWS=2
# Public bucket/prefix the published datasets live under.
DATASETS_PUBLIC_BUCKET=vortex-public-datasets
# Storage backend: local (writes to disk) | memory (tests only).
DATASETS_STORAGE=local
# Root directory for the local storage backend.
DATASETS_LOCAL_DIR=.datasets

# ── Anti-griefing controls (issue #453) ─────────────────────────────────────
# Master switch: when false, accept-without-fill controls are never applied.
ANTIGRIEFING_ENABLED=true
# Rolling window for the unfilled-accept ratio, in seconds.
ANTIGRIEFING_WINDOW_SECONDS=86400
# Resolved accepts required before a tier may be applied.
ANTIGRIEFING_MIN_SAMPLES=10
# Unfilled-accept ratio (0-1) at which a solver escalates one tier.
ANTIGRIEFING_RATIO_THRESHOLD=0.5
# Ratio (0-1) at/below which a solver steps back down one tier.
ANTIGRIEFING_RECOVERY_RATIO=0.2
# Cooldown length applied on escalation, in seconds.
ANTIGRIEFING_COOLDOWN_SECONDS=300
# Concurrent accepted intents allowed from tier 2 onwards.
ANTIGRIEFING_CONCURRENCY_CAP=2
# Suspension length in seconds; 0 = until an operator clears it.
ANTIGRIEFING_SUSPENSION_SECONDS=3600

