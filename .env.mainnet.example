# .env.mainnet.example
#
# Environment template for PRODUCTION against Stellar MAINNET.
# Copy to .env (or inject via your secrets manager) and fill in every
# value marked with <CHANGE_ME>.  ALL values marked REQUIRED will cause
# the process to refuse to start if left blank.
#
#   cp .env.mainnet.example .env
#
# ⚠  WARNING — MAINNET CHECKLIST ⚠
#   □  SOROBAN_SIGNING_KEY is a real, funded mainnet keypair stored in a
#      proper secrets manager (AWS Secrets Manager, Vault, etc.).  Never
#      commit it to version control.
#   □  CORS_ORIGIN is an explicit origin — never "*" in production.
#   □  SETTLEMENT_CONTRACT_ID and SOLVER_REGISTRY_CONTRACT_ID are the
#      deployed mainnet contract addresses.
#   □  DATABASE_URL points to a production-grade managed database, not a
#      local Docker container.
#   □  NODE_ENV=production (enforces signing-key validation at startup).
#
# Closes #136

# ─── Database ────────────────────────────────────────────────────────────────
# REQUIRED: production Postgres connection string.
# Use a secrets manager to inject this — never hardcode credentials here.
DATABASE_URL=<CHANGE_ME>  # e.g. postgresql://vortex:<SECRET>@db.prod.vortex.trade:5432/vortex?schema=public

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
# REQUIRED: must be "production" to enable signing-key validation and strict
# CORS enforcement at startup.
NODE_ENV=production

# ─── Stellar / Soroban ───────────────────────────────────────────────────────
# REQUIRED: mainnet only.
STELLAR_NETWORK=mainnet
SOROBAN_RPC_URL=https://mainnet.stellar.validationcloud.io/v1/<YOUR_API_KEY>
# Alternative public endpoints (pick one or run your own):
#   https://soroban.stellar.org     — Stellar Foundation (rate-limited)
#   https://rpc.ankr.com/stellar    — Ankr

# REQUIRED: deployed mainnet contract addresses.
# The process will warn (not exit) if these are blank in non-production
# environments, but will refuse to operate correctly without them.
SETTLEMENT_CONTRACT_ID=<CHANGE_ME>         # 56-char Stellar contract ID
SOLVER_REGISTRY_CONTRACT_ID=<CHANGE_ME>    # 56-char Stellar contract ID

# REQUIRED in production: backend Soroban signer secret seed.
# Must be a valid Stellar secret seed (starts with "S", 56 base32 chars).
# The process exits at startup if this is missing or malformed in production.
# Store in a secrets manager and inject at runtime — never commit.
SOROBAN_SIGNING_KEY=<CHANGE_ME>

# Fee percentile used when estimating Soroban inclusion fees.
# p90 provides better confirmation speed on mainnet under load.
SOROBAN_FEE_PERCENTILE=p90

# ─── CORS ────────────────────────────────────────────────────────────────────
# REQUIRED: explicit origin — "*" is rejected in production.
CORS_ORIGIN=https://app.vortex.trade    # <CHANGE_ME>

# ─── WebSocket ───────────────────────────────────────────────────────────────
# Tune based on expected solver + frontend connection count.
WS_MAX_CONNECTIONS=5000

# ─── Observability ───────────────────────────────────────────────────────────
# Recommended in production: set to your Sentry project DSN.
SENTRY_DSN=<CHANGE_ME>

# info is the right level for production — "debug" is too noisy.
LOG_LEVEL=info
