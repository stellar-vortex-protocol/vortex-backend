// Prisma schema for the solver network.
// NOTE: only the Solver model is shown/edited here for issue #643.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Solver {
  id              String   @id @default(uuid())
  address         String   @unique
  name            String
  avatarUrl       String?
  description     String?
  websiteUrl      String?
  verified        Boolean  @default(false)
  supportedChains String[]
  supportedTokens String[]
  avgFillTime     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([verified])
}
